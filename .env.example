# Canonical public site
NEXT_PUBLIC_SITE_URL=https://veltrano.ma
SITE_URL=https://veltrano.ma
# Extra origins (comma-separated). Apex + www are always allowed.
CORS_ORIGINS=https://veltrano.ma,https://www.veltrano.ma

# Required in production. Protects /admin and every admin API route.
# Local development remains accessible without it.
ADMIN_SECRET=

# Persist orders/coupons/WhatsApp queue (EasyPanel volume → /app/data/store)
DATA_DIR=/app/data/store

# EasyPanel injects these; Next standalone listens on PORT + HOSTNAME (HOST is mapped).
PORT=3000
HOST=0.0.0.0

# Required in EasyPanel production. Startup applies additive SQL migrations and
# idempotently backfills the legacy JSON records once.
DATABASE_URL=

# Welcome coupon validity (days)
WELCOME_COUPON_VALIDITY_DAYS=60

# Gmail API welcome-coupon delivery. Without these, signup rows and valid codes
# are still saved with email status "failed" and can be retried from admin.
GMAIL_ACCESS_TOKEN=
GMAIL_SENDER=

# Optional connected reporting/sync indicators
GOOGLE_SHEETS_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=
GA4_PROPERTY_ID=

# Meta WhatsApp Cloud API — used first when both are set
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_VERSION=v22.0

# Twilio WhatsApp — used if Meta vars are missing
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
