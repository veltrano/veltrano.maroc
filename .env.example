# Optional. If set, /admin and GET /api/admin/orders require this key
# (header x-admin-secret or query ?key=).
ADMIN_SECRET=

# Persist orders/coupons/WhatsApp queue (EasyPanel volume → /app/data/store)
DATA_DIR=/app/data/store

# EasyPanel injects these; Next standalone listens on PORT + HOSTNAME (HOST is mapped).
PORT=3000
HOST=0.0.0.0

# Meta WhatsApp Cloud API — used first when both are set
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_VERSION=v22.0

# Twilio WhatsApp — used if Meta vars are missing
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=


# Meta WhatsApp Cloud API — used first when both are set
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_VERSION=v22.0

# Twilio WhatsApp — used if Meta vars are missing
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
